{
  "name": "rmk-gui",
  "type": "module",
  "private": true,
  "scripts": {
    "dev:web": "nuxt dev",
    "dev:tauri": "tauri dev",
    "build:web": "nuxt generate",
    "build:tauri": "tauri build",
    "build:wasm": "python3 scripts/build-rynk-wasm.py",
    "qemu": "node qemu/run.mjs",
    "generate": "nuxt generate",
    "lint": "run-s lint:ts lint:rs",
