{
  "name": "rmk-gui",
  "type": "module",
  "private": true,
  "scripts": {
    "dev:web": "vite",
    "dev:tauri": "tauri dev",
    "build:web": "vite build",
    "build:tauri": "tauri build",
    "build:icons": "node scripts/build-icons.ts",
    "build:wasm": "python3 scripts/build-rynk-wasm.py",
    "qemu": "node qemu/run.mjs",
    "test": "vitest run",
    "test:qemu": "vitest run --config vitest.qemu.config.ts",
    "lint": "run-s lint:ts lint:rs",
    "lint:ts": "eslint .",
    "lint:rs": "cd src-tauri && cargo clippy --all-targets -- -D warnings",
    "lint:fix": "run-s lint:fix:ts lint:fix:rs",
    "lint:fix:ts": "eslint . --fix",
    "lint:fix:rs": "cd src-tauri && cargo fmt",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@ark-ui/svelte": "^5.22.1",
    "@iconify/svelte": "^5.0.1",
    "@tauri-apps/api": "^2.11.1",
    "neverthrow": "^8.2.0",
    "ts-pattern": "^5.9.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@iconify-json/lucide": "^1.2.119",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^26.1.1",
    "@types/w3c-web-hid": "^1.0.7",
    "@types/w3c-web-serial": "^1.0.8",
    "eslint": "^10.7.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-svelte": "^3.11.0",
    "npm-run-all2": "^9.0.2",
    "svelte": "^5.38.6",
    "svelte-check": "^4.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
