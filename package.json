{
  "name": "rmk-gui",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "nuxt prepare",
    "dev:web": "nuxt dev",
    "dev:tauri": "tauri dev",
    "build:web": "nuxt generate",
    "build:tauri": "tauri build",
    "build:wasm": "python3 scripts/build-rynk-wasm.py",
    "qemu": "uv run scripts/run-qemu.py",
    "lint": "run-s lint:ts lint:rs",
    "lint:ts": "eslint .",
    "lint:rs": "cd src-tauri && cargo clippy --all-targets -- -D warnings",
    "lint:fix": "run-s lint:fix:ts lint:fix:rs",
    "lint:fix:ts": "eslint . --fix",
    "lint:fix:rs": "cd src-tauri && cargo fmt",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@pinia/nuxt": "^1.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.3",
    "neverthrow": "^8.2.0",
    "pinia": "^4.0.3",
    "reka-ui": "^2.11.0",
    "tailwindcss": "^4.3.3",
    "ts-pattern": "^5.9.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@nuxt/eslint": "^1.17.0",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^26.6.5",
    "@types/w3c-web-hid": "^1.0.7",
    "@types/w3c-web-serial": "^1.0.8",
    "eslint": "^10.12.0",
    "eslint-plugin-better-tailwindcss": "^4.9.0",
    "npm-run-all2": "^9.0.3",
    "nuxt": "^4.6.1",
    "typescript": "^6.0.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.13"
  }
}
